{
  "description": "Un Spec legacy SANS categorie : le preflight du coder le classe avant tout routage, puis la discipline bug s'applique comme si /nspec l'avait classe.",
  "setup": {
    "scope": "ndev",
    "spec": {
      "status": "in_progress",
      "category": null,
      "phases": ["Build"],
      "tasks": [{ "title": "repair the defect" }]
    },
    "slots": {
      "repro_check": [{ "green_when_file_exists": "fixed" }],
      "build_check": ["green"]
    }
  },
  "answers": [
    {
      "when": { "type": "judge", "label": "which category?" },
      "reply": { "verdict": "bug" }
    },
    {
      "when": { "type": "spawn_subagent", "label": "write the reproduction" },
      "reply": { "diff": "un check qui echoue sur ce defaut" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "Answer 'automated'" },
      "reply": { "decision": "automated" }
    },
    {
      "when": { "type": "spawn_subagent", "label": "repair the defect" },
      "effect": { "write_file": "fixed" },
      "reply": { "diff": "le defaut est repare" }
    },
    {
      "when": { "type": "spawn_subagent", "label": "implement" },
      "reply": { "diff": "la tranche est implementee" }
    },
    {
      "when": { "type": "spawn_subagent" },
      "reply": { "diff": "audit clean" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "in review" },
      "reply": { "decision": "approve" }
    },
    {
      "when": { "type": "ask_human" },
      "reply": { "decision": "yes" }
    }
  ],
  "expect": {
    "surfaced": [
      "sub_workflow:coder",
      "judge:which category?",
      "spawn_subagent:write the reproduction",
      "ask_human:Answer 'automated'",
      "spawn_subagent:repair the defect",
      "spawn_subagent:implement",
      "done",
      "spawn_subagent:user_stories",
      "spawn_subagent:testing_decisions",
      "spawn_subagent:implementation_decisions",
      "spawn_subagent:out_of_scope",
      "ask_human:in review",
      "ask_human:confirm",
      "done"
    ],
    "journal": [
      {
        "slot": "repro_check",
        "expect": "red",
        "outcome": "failed",
        "satisfied": true,
        "blocking": true
      },
      {
        "slot": "repro_check",
        "expect": "green",
        "outcome": "passed",
        "satisfied": true,
        "blocking": true,
        "same_check_as": 0
      },
      {
        "slot": "build_check",
        "expect": "green",
        "outcome": "passed",
        "satisfied": true,
        "blocking": true
      }
    ],
    "spec_status": "completed",
    "category": "bug",
    "tasks": { "repair the defect": "done" },
    "blackboard": {
      "category_choice": "bug",
      "spec_category": "bug",
      "repro_mode": "automated",
      "gate_green": true,
      "done_ok": "yes"
    }
  }
}
