{
  "description": "Un bug juge IMPRATICABLE a automatiser : le protocole humain avant et apres le fix, aucune tentative de repro_check, le build_check seul au journal.",
  "setup": {
    "scope": "ndev",
    "spec": {
      "status": "in_progress",
      "category": "bug",
      "phases": ["Build"],
      "tasks": [{ "title": "repair the defect" }]
    },
    "slots": {
      "repro_check": [{ "green_when_file_exists": "fixed" }],
      "build_check": ["green"]
    }
  },
  "answers": [
    {
      "when": { "type": "spawn_subagent", "label": "write the reproduction" },
      "reply": { "diff": "aucun check ne peut piloter le lecteur de badge" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "Answer 'automated'" },
      "reply": { "decision": "manual" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "YOU are the check" },
      "reply": {
        "decision": "PROTOCOLE : badger a froid sur le lecteur de l'entree nord, puis rebadger dans les deux secondes. OBSERVE : la seconde lecture est refusee et la LED reste rouge."
      }
    },
    {
      "when": { "type": "spawn_subagent", "label": "repair the defect" },
      "reply": { "diff": "la temporisation du lecteur est corrigee" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "The fix is in." },
      "reply": { "decision": "fixed" }
    },
    {
      "when": { "type": "spawn_subagent", "label": "implement" },
      "reply": { "diff": "la tranche est implementee" }
    },
    {
      "when": { "type": "spawn_subagent" },
      "reply": { "diff": "audit clean" }
    },
    {
      "when": { "type": "ask_human", "prompt_contains": "in review" },
      "reply": { "decision": "approve" }
    },
    {
      "when": { "type": "ask_human" },
      "reply": { "decision": "yes" }
    }
  ],
  "expect": {
    "surfaced": [
      "sub_workflow:coder",
      "spawn_subagent:write the reproduction",
      "ask_human:Answer 'automated'",
      "ask_human:YOU are the check",
      "spawn_subagent:repair the defect",
      "ask_human:The fix is in.",
      "spawn_subagent:implement",
      "done",
      "spawn_subagent:user_stories",
      "spawn_subagent:testing_decisions",
      "spawn_subagent:implementation_decisions",
      "spawn_subagent:out_of_scope",
      "ask_human:in review",
      "ask_human:confirm",
      "done"
    ],
    "journal": [
      {
        "slot": "build_check",
        "expect": "green",
        "outcome": "passed",
        "satisfied": true,
        "blocking": true
      }
    ],
    "spec_status": "completed",
    "category": "bug",
    "tasks": { "repair the defect": "done" },
    "blackboard": {
      "repro_mode": "manual",
      "manual_repro_before": "PROTOCOLE : badger a froid sur le lecteur de l'entree nord, puis rebadger dans les deux secondes. OBSERVE : la seconde lecture est refusee et la LED reste rouge.",
      "manual_repro_after": "fixed",
      "gate_green": true,
      "done_ok": "yes"
    }
  }
}
